 #### Step 3 — Re-apply grants inside outline_new                                                                                                                                                                  
                                                                                                                                                                                                                   
 ```bash                                                                                                                                                                                                           
   psql -d outline_new                                                                                                                                                                                             
 ```                                                                                                                                                                                                               
                                                                                                                                                                                                                   
 ```sql                                                                                                                                                                                                            
   GRANT ALL PRIVILEGES ON ALL TABLES IN SCHEMA public TO "outline-db-user";                                                                                                                                       
   GRANT ALL PRIVILEGES ON ALL SEQUENCES IN SCHEMA public TO "outline-db-user";                                                                                                                                    
   GRANT ALL PRIVILEGES ON ALL FUNCTIONS IN SCHEMA public TO "outline-db-user";                                                                                                                                    
   ALTER DEFAULT PRIVILEGES IN SCHEMA public GRANT ALL ON TABLES TO "outline-db-user";                                                                                                                             
   ALTER DEFAULT PRIVILEGES IN SCHEMA public GRANT ALL ON SEQUENCES TO "outline-db-user";                                                                                                                          
   ALTER DEFAULT PRIVILEGES IN SCHEMA public GRANT ALL ON FUNCTIONS TO "outline-db-user";                                                                                                                          
   \q                                                                                                                                                                                                              
 ```                                                                                                                                                                                                               
                                                                                                                                                                                                                   
 #### Step 4 — Scale Outline to 0 replicas (stops writes)                                                                                                                                                          
                                                                                                                                                                                                                   
 Run this from your K8s control machine:                                                                                                                                                                           
                                                                                                                                                                                                                   
 ```bash                                                                                                                                                                                                           
   kubectl scale deployment outline-outline --replicas=0 -n <your-namespace>                                                                                                                                       
   # or in Helm: set replicas: 0 and upgrade                                                                                                                                                                       
 ```                                                                                                                                                                                                               
                                                                                                                                                                                                                   
 Wait ~30 seconds for pods to terminate.                                                                                                                                                                           
                                                                                                                                                                                                                   
 #### Step 5 — Kill any lingering connections and swap                                                                                                                                                             
                                                                                                                                                                                                                   
 ```bash                                                                                                                                                                                                           
   sudo su - postgres                                                                                                                                                                                              
   psql -d postgres                                                                                                                                                                                                
 ```                                                                                                                                                                                                               
                                                                                                                                                                                                                   
 ```sql                                                                                                                                                                                                            
   -- Kill any stragglers connected to the old outline DB                                                                                                                                                          
   SELECT pg_terminate_backend(pid) FROM pg_stat_activity WHERE datname = 'outline' AND pid <> pg_backend_pid();                                                                                                   
                                                                                                                                                                                                                   
   -- Drop the staging DB from last time (if it exists)                                                                                                                                                            
   DROP DATABASE IF EXISTS outline_old;                                                                                                                                                                            
                                                                                                                                                                                                                   
   -- Swap names                                                                                                                                                                                                   
   ALTER DATABASE outline RENAME TO outline_old;                                                                                                                                                                   
   ALTER DATABASE outline_new RENAME TO outline;                                                                                                                                                                   
                                                                                                                                                                                                                   
   -- Clean up                                                                                                                                                                                                     
   DROP DATABASE outline_old;                                                                                                                                                                                      
   \q                                                                                                                                                                                                              
 ```                                                                                                                                                                                                               
                                                                                                                                                                                                                   
 #### Step 6 — Scale Outline back up                                                                                                                                                                               
                                                                                                                                                                                                                   
 ```bash                                                                                                                                                                                                           
   kubectl scale deployment outline-outline --replicas=2 -n <your-namespace>                                                                                                                                       
 ```                                                                                                                                                                                                               
                                                                                                                                                                                                                   
  Total downtime: ~10–30 seconds (just the swap + pod restart).                                                                                                                                                    
                                                                                                                                                                                                                   
 ────────────────────────────────────────────────────────────────────────────────                                                                                                                                  
                                                                                                                                                                                                                   
 ### Method B: In-Place Overwrite (faster setup, longer downtime)                                                                                                                                                  
                                                                                                                                                                                                                   
 Use this when you don't care about brief downtime or the DB is small.                                                                                                                                             
                                                                                                                                                                                                                   
 #### Step 1 — Stop Outline completely                                                                                                                                                                             
                                                                                                                                                                                                                   
 ```bash                                                                                                                                                                                                           
   kubectl scale deployment outline-outline --replicas=0 -n <your-namespace>                                                                                                                                       
 ```                                                                                                                                                                                                               
                                                                                                                                                                                                                   
 #### Step 2 — Restore directly over the existing DB using --clean                                                                                                                                                 
                                                                                                                                                                                                                   
 ```bash                                                                                                                                                                                                           
   sudo su - postgres                                                                                                                                                                                              
   pg_restore \                                                                                                                                                                                                    
     -d outline \                                                                                                                                                                                                  
     --clean \                                                                                                                                                                                                     
     --if-exists \                                                                                                                                                                                                 
     --no-owner \                                                                                                                                                                                                  
     --no-privileges \                                                                                                                                                                                             
     --verbose \                                                                                                                                                                                                   
     /tmp/outline_migration_latest.dump                                                                                                                                                                            
 ```                                                                                                                                                                                                               
                                                                                                                                                                                                                   
 │ --clean --if-exists tells pg_restore to DROP existing objects before recreating them. This resets the DB state cleanly.                                                                                         
                                                                                                                                                                                                                   
 #### Step 3 — Re-apply grants                                                                                                                                                                                     
                                                                                                                                                                                                                   
 ```bash                                                                                                                                                                                                           
   psql -d outline                                                                                                                                                                                                 
 ```                                                                                                                                                                                                                                                                                                                                                                                                                                  
                                                                                                                                                                                                                   
 ```sql                                                                                                                                                                                                            
   GRANT ALL PRIVILEGES ON ALL TABLES IN SCHEMA public TO "outline-db-user";                                                                                                                                       
   GRANT ALL PRIVILEGES ON ALL SEQUENCES IN SCHEMA public TO "outline-db-user";                                                                                                                                    
   ALTER DEFAULT PRIVILEGES IN SCHEMA public GRANT ALL ON TABLES TO "outline-db-user";                                                                                                                             
   ALTER DEFAULT PRIVILEGES IN SCHEMA public GRANT ALL ON SEQUENCES TO "outline-db-user";                                                                                                                          
   \q                                                                                                                                                                                                              
 ```                                                                                                                                                                                                               
                                                                                                                                                                                                                   
 #### Step 4 — Start Outline                                                                                                                                                                                       

 ```bash                                                                                                                                                                                                           
   kubectl scale deployment outline-outline --replicas=2 -n <your-namespace>                                                                                                                                       
 ```                                                                                                                                                                                                               
                                                                                                                                                                                                                   
  Downtime: duration of the entire restore (could be minutes).                                                                                                                                                     
                                                                                                                                                                                                                   
